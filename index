const STORAGE_KEY = "ap_world_vocab_progress_v1";

const loadProgress = () => {
  try {
    const raw = localStorage.getItem(STORAGE_KEY);
    return raw ? JSON.parse(raw) : { known: {}, attempts: {}, correct: {} };
  } catch {
    return { known: {}, attempts: {}, correct: {} };
  }
};

const saveProgress = (p) => {
  try { localStorage.setItem(STORAGE_KEY, JSON.stringify(p)); } catch {}
};

