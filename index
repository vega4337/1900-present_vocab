// FLASHCARDS
function Flashcards({ cards, progress, setProgress, onExit }) {
  const [order, setOrder] = useState(() => cards.map((_, i) => i));
  const [idx, setIdx] = useState(0);
  const [flipped, setFlipped] = useState(false);

  useEffect(() => { setOrder(cards.map((_, i) => i)); setIdx(0); setFlipped(false); }, [cards]);

  if (!cards.length) return <Empty onExit={onExit} />;

  const current = cards[order[idx]];
  const isKnown = !!progress.known[current.num];

  const next = () => { setFlipped(false); setIdx(i => (i + 1) % order.length); };
  const prev = () => { setFlipped(false); setIdx(i => (i - 1 + order.length) % order.length); };

  const shuffle = () => {
    const arr = [...order];
    for (let i = arr.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [arr[i], arr[j]] = [arr[j], arr[i]];
    }
    setOrder(arr);
    setIdx(0);
    setFlipped(false);
  };

  const markKnown = (known) => {
    setProgress(p => ({ ...p, known: { ...p.known, [current.num]: known } }));
    setTimeout(next, 150);
  };

  return (
    <motion.div initial={{ opacity: 0 }} animate={{ opacity: 1 }} transition={{ duration: 0.3 }}>
      <div className="flex items-center justify-between mb-4">
        <div className="mono-font text-[10px] tracking-[0.25em] text-stone-600 uppercase">
          Flashcards · {idx + 1} of {order.length}
        </div>
        <button
          onClick={shuffle}
          className="mono-font text-[10px] tracking-widest uppercase border border-stone-700 px-2.5 py-1.5 hover:bg-stone-800 hover:text-amber-50 transition inline-flex items-center gap-1.5"
        >
          <Shuffle size={12} /> Shuffle
        </button>
      </div>

      <div className="relative" style={{ perspective: "1400px" }}>
        <motion.div
          key={current.num + (flipped ? "-b" : "-f")}
          onClick={() => setFlipped(f => !f)}
          className="cursor-pointer min-h-[360px] md:min-h-[420px] border-2 border-stone-700 deckle bg-amber-50/60 p-8 md:p-12 flex flex-col"
          initial={{ rotateY: flipped ? -90 : 90, opacity: 0 }}
          animate={{ rotateY: 0, opacity: 1 }}
          transition={{ duration: 0.35 }}
        >
          <div className="flex items-baseline justify-between mb-6">
            <div className="mono-font text-[10px] tracking-[0.25em] uppercase text-amber-800">
              № {current.num} · {current.unit}
            </div>
            {isKnown && (
              <div className="mono-font text-[9px] tracking-widest uppercase text-emerald-700 inline-flex items-center gap-1">
                <Check size={11} /> Known
              </div>
            )}
          </div>

          <div className="flex-1 flex items-center justify-center text-center">
            {!flipped ? (
              <div>
                <div className="ornament text-3xl mb-4">❦</div>
                <h2 className="display-font font-bold text-3xl md:text-5xl leading-tight">
                  {current.term}
                </h2>
                <div className="mt-6 mono-font text-[10px] tracking-widest uppercase text-stone-500">
                  Tap to reveal
                </div>
              </div>
            ) : (
              <div>
                <div className="display-font italic text-amber-800 text-xl mb-3">{current.term}</div>
                <p className="text-lg md:text-xl leading-relaxed text-stone-800">
                  {current.def}
                </p>
              </div>
            )}
          </div>
        </motion.div>
      </div>

      <div className="grid grid-cols-2 gap-3 mt-5">
        <button
          onClick={() => markKnown(false)}
          className="border-2 border-stone-700 px-4 py-3 hover:bg-stone-800 hover:text-amber-50 transition inline-flex items-center justify-center gap-2"
        >
          <X size={16} /> <span className="mono-font text-xs tracking-widest uppercase">Still Learning</span>
        </button>
        <button
          onClick={() => markKnown(true)}
          className="border-2 border-emerald-800 bg-emerald-800 text-amber-50 px-4 py-3 hover:bg-emerald-900 transition inline-flex items-center justify-center gap-2"
        >
          <Check size={16} /> <span className="mono-font text-xs tracking-widest uppercase">I Know This</span>
        </button>
      </div>

      <div className="flex items-center justify-between mt-6">
        <button onClick={prev} className="inline-flex items-center gap-1 text-stone-700 hover:text-stone-900">
          <ChevronLeft size={20} /> <span className="mono-font text-xs tracking-widest uppercase">Prev</span>
        </button>
        <div className="mono-font text-[10px] tracking-widest uppercase text-stone-500">
          {Object.keys(progress.known).filter(k => progress.known[k]).length} marked known overall
        </div>
        <button onClick={next} className="inline-flex items-center gap-1 text-stone-700 hover:text-stone-900">
          <span className="mono-font text-xs tracking-widest uppercase">Next</span> <ChevronRight size={20} />
        </button>
      </div>
    </motion.div>
  );
}

// QUIZ
function Quiz({ cards, allCards, progress, setProgress, onExit }) {
  const [questions, setQuestions] = useState([]);
  const [qIdx, setQIdx] = useState(0);
  const [selected, setSelected] = useState(null);
  const [showResult, setShowResult] = useState(false);
  const [score, setScore] = useState({ correct: 0, total: 0 });
  const [finished, setFinished] = useState(false);

  const buildQuiz = () => {
    const pool = [...cards];
    for (let i = pool.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [pool[i], pool[j]] = [pool[j], pool[i]];
    }
    const qs = pool.slice(0, Math.min(10, pool.length)).map(card => {
      const distractors = allCards
        .filter(c => c.num !== card.num)
        .sort(() => Math.random() - 0.5)
        .slice(0, 3);
      const choices = [card, ...distractors].sort(() => Math.random() - 0.5);
      return { card, choices };
    });
    setQuestions(qs);
    setQIdx(0);
    setSelected(null);
    setShowResult(false);
    setScore({ correct: 0, total: 0 });
    setFinished(false);
  };

  useEffect(() => { buildQuiz(); }, [cards]);

  if (!cards.length) return <Empty onExit={onExit} />;
  if (!questions.length) return null;

  const q = questions[qIdx];

  const onChoose = (choice) => {
    if (showResult) return;
    setSelected(choice);
    setShowResult(true);
    const correct = choice.num === q.card.num;
    setScore(s => ({ correct: s.correct + (correct ? 1 : 0), total: s.total + 1 }));
    setProgress(p => ({
      ...p,
      attempts: { ...p.attempts, [q.card.num]: (p.attempts[q.card.num] || 0) + 1 },
      correct: { ...p.correct, [q.card.num]: (p.correct[q.card.num] || 0) + (correct ? 1 : 0) },
    }));
  };

  const goNext = () => {
    if (qIdx + 1 >= questions.length) {
      setFinished(true);
    } else {
      setQIdx(i => i + 1);
      setSelected(null);
      setShowResult(false);
    }
  };

  if (finished) {
    const pct = Math.round((score.correct / score.total) * 100);
    return (
      <motion.div initial={{ opacity: 0, y: 10 }} animate={{ opacity: 1, y: 0 }} className="text-center py-8">
        <div className="ornament text-4xl mb-4">❦</div>
        <Trophy size={48} strokeWidth={1.2} className="mx-auto text-amber-800 mb-4" />
        <h2 className="display-font font-bold text-4xl md:text-5xl mb-2">Examination Complete</h2>
        <p className="display-font italic text-2xl text-stone-700 mb-6">
          You scored {score.correct} of {score.total} <span className="text-amber-800">— {pct}%</span>
        </p>
        <div className="flex gap-3 justify-center">
          <button
            onClick={buildQuiz}
            className="border-2 border-stone-700 px-5 py-2.5 hover:bg-stone-800 hover:text-amber-50 transition mono-font text-xs tracking-widest uppercase"
          >
            Try Another
          </button>
          <button
            onClick={onExit}
            className="border-2 border-stone-700 bg-stone-800 text-amber-50 px-5 py-2.5 hover:bg-stone-900 transition mono-font text-xs tracking-widest uppercase"
          >
            Back to Index
          </button>
        </div>
      </motion.div>
    );
  }

  return (
    <motion.div initial={{ opacity: 0 }} animate={{ opacity: 1 }} transition={{ duration: 0.3 }}>
      <div className="flex items-center justify-between mb-4">
        <div className="mono-font text-[10px] tracking-[0.25em] text-stone-600 uppercase">
          Examination · {qIdx + 1} of {questions.length}
        </div>
        <div className="mono-font text-[10px] tracking-[0.25em] text-stone-600 uppercase">
          Score: {score.correct} / {score.total}
        </div>
      </div>

      <div className="border-2 border-stone-700 deckle bg-amber-50/60 p-6 md:p-8 mb-5">
        <div className="mono-font text-[10px] tracking-widest uppercase text-amber-800 mb-3">
          Which term matches this definition?
        </div>
        <p className="display-font text-xl md:text-2xl leading-snug text-stone-900">
          {q.card.def}
        </p>
      </div>

      <div className="grid grid-cols-1 md:grid-cols-2 gap-3">
        {q.choices.map((choice, i) => {
          const isCorrect = choice.num === q.card.num;
          const isSelected = selected && choice.num === selected.num;
          let cls = "border-2 border-stone-400 bg-amber-50/40 hover:border-stone-700 hover:bg-amber-50";
          if (showResult && isCorrect) cls = "border-2 border-emerald-800 bg-emerald-100";
          else if (showResult && isSelected && !isCorrect) cls = "border-2 border-red-800 bg-red-100";
          else if (showResult) cls = "border-2 border-stone-300 bg-amber-50/30 opacity-60";
          return (
            <button
              key={choice.num}
              onClick={() => onChoose(choice)}
              disabled={showResult}
              className={`${cls} text-left p-4 transition`}
            >
              <div className="flex items-start gap-3">
                <div className="mono-font text-xs text-amber-800 pt-0.5">{String.fromCharCode(65 + i)}.</div>
                <div className="display-font text-lg font-semibold flex-1">{choice.term}</div>
                {showResult && isCorrect && <Check size={18} className="text-emerald-800 mt-1" />}
                {showResult && isSelected && !isCorrect && <X size={18} className="text-red-800 mt-1" />}
              </div>
            </button>
          );
        })}
      </div>

      {showResult && (
        <motion.div
          initial={{ opacity: 0, y: 6 }}
          animate={{ opacity: 1, y: 0 }}
          className="mt-5 flex items-center justify-between"
        >
          <div className="text-sm italic text-stone-700">
            Answer: <span className="display-font font-bold not-italic">{q.card.term}</span>
          </div>
          <button
            onClick={goNext}
            className="border-2 border-stone-700 bg-stone-800 text-amber-50 px-4 py-2 hover:bg-stone-900 transition mono-font text-xs tracking-widest uppercase inline-flex items-center gap-2"
          >
            {qIdx + 1 >= questions.length ? "Finish" : "Next"} <ChevronRight size={14} />
          </button>
        </motion.div>
      )}
    </motion.div>
  );
}

// BROWSE
function Browse({ cards, progress }) {
  const [search, setSearch] = useState("");
  const [showAll, setShowAll] = useState(true);

  const visible = useMemo(() => {
    const q = search.trim().toLowerCase();
    if (!q) return cards;
    return cards.filter(c =>
      c.term.toLowerCase().includes(q) || c.def.toLowerCase().includes(q)
    );
  }, [cards, search]);

  return (
    <motion.div initial={{ opacity: 0 }} animate={{ opacity: 1 }} transition={{ duration: 0.3 }}>
      <div className="flex flex-col md:flex-row md:items-center gap-3 mb-6">
        <div className="relative flex-1">
          <Search size={14} className="absolute left-3 top-1/2 -translate-y-1/2 text-stone-500" />
          <input
            value={search}
            onChange={e => setSearch(e.target.value)}
            placeholder="Search terms or definitions…"
            className="w-full pl-9 pr-3 py-2.5 border border-stone-400 bg-amber-50/40 focus:outline-none focus:border-stone-700 italic"
          />
        </div>
        <button
          onClick={() => setShowAll(s => !s)}
          className="border border-stone-700 px-3 py-2.5 hover:bg-stone-800 hover:text-amber-50 transition mono-font text-[10px] tracking-widest uppercase inline-flex items-center justify-center gap-1.5"
        >
          {showAll ? <><EyeOff size={12} /> Hide Definitions</> : <><Eye size={12} /> Show Definitions</>}
        </button>
      </div>

      <div className="mono-font text-[10px] tracking-[0.25em] text-stone-600 uppercase mb-3">
        {visible.length} {visible.length === 1 ? "entry" : "entries"}
      </div>

      <div className="space-y-4">
        {visible.map(c => (
          <div key={c.num} className="border-l-2 border-amber-800 pl-4 py-1">
            <div className="flex items-baseline gap-2 flex-wrap">
              <span className="mono-font text-[10px] text-amber-800">№ {c.num}</span>
              <h3 className="display-font font-bold text-xl text-stone-900">{c.term}</h3>
              <span className="mono-font text-[9px] tracking-widest uppercase text-stone-500 border border-stone-300 px-1.5 py-0.5">
                {c.unit}
              </span>
              {progress.known[c.num] && (
                <span className="mono-font text-[9px] tracking-widest uppercase text-emerald-700">
                  ✓ known
                </span>
              )}
            </div>
            {showAll && (
              <p className="text-stone-800 leading-relaxed mt-1">{c.def}</p>
            )}
          </div>
        ))}
        {!visible.length && (
          <div className="text-center py-12 text-stone-500 italic">
            No entries match your search.
          </div>
        )}
      </div>
    </motion.div>
  );
}

function Empty({ onExit }) {
  return (
    <div className="text-center py-12">
      <p className="display-font italic text-xl text-stone-700 mb-4">No terms in this selection.</p>
      <button onClick={onExit} className="border-2 border-stone-700 px-4 py-2 hover:bg-stone-800 hover:text-amber-50 transition mono-font text-xs tracking-widest uppercase">
        Back
      </button>
    </div>
  );
}

function Footer() {
  return (
    <footer className="mt-16 pt-6 border-t border-stone-300 text-center">
      <div className="ornament text-2xl mb-2">❦</div>
      <p className="mono-font text-[10px] tracking-[0.2em] uppercase text-stone-500">
        159 Terms · Unit VI · 1900–Present
      </p>
    </footer>
  );
}
