import React, { useState, useEffect, useMemo } from "react";
import { motion, AnimatePresence } from "framer-motion";
import { ChevronLeft, ChevronRight, RotateCcw, Check, X, BookOpen, Brain, List, Shuffle, Trophy, Eye, EyeOff, Search } from "lucide-react";

const VOCAB_DATA = [
  { unit: "WWI", num: 1, term: "World War I", def: "A global conflict from 1914 to 1918 between the Allied and Central Powers, sparked by tensions among European empires. It introduced industrial-scale warfare including trenches, machine guns, and chemical weapons, and reshaped the political map of Europe and the Middle East." },
  { unit: "WWI", num: 2, term: "Archduke Francis Ferdinand", def: "The heir to the Austro-Hungarian throne whose assassination in Sarajevo in June 1914 by Gavrilo Princip triggered the start of WWI. His death set off the chain of alliance-driven declarations of war across Europe." },
  { unit: "WWI", num: 3, term: "Triple Alliance", def: "The pre-WWI defensive alliance formed in 1882 between Germany, Austria-Hungary, and Italy. It opposed the Triple Entente of Britain, France, and Russia, though Italy later switched sides during the war." },
  { unit: "WWI", num: 4, term: "Central Powers", def: "The WWI alliance of Germany, Austria-Hungary, the Ottoman Empire, and Bulgaria. They fought against the Allied Powers and were ultimately defeated, leading to the collapse of all four of their empires." },
  { unit: "WWI", num: 5, term: "Total War", def: "A type of warfare in which countries mobilize all available resources — economic, industrial, and human — toward the war effort. WWI was the first major total war, with civilians and entire economies directed toward military production." },
  { unit: "WWI", num: 6, term: "Nationalism", def: "Intense loyalty and devotion to one's nation, often accompanied by the belief that one's country is superior to others. It was a major underlying cause of WWI, fueling rivalries among European powers and independence movements within empires." },
  { unit: "WWI", num: 7, term: "Self-determination", def: "The principle that peoples and nations have the right to choose their own form of government and political status. Promoted by Woodrow Wilson in his Fourteen Points, it influenced post-WWI border changes and later anti-colonial movements." },
  { unit: "WWI", num: 8, term: "Propaganda", def: "Information, often biased or misleading, used by governments to influence public opinion and rally support for war. WWI saw unprecedented use of posters, films, and news censorship to demonize enemies and encourage enlistment." },
  { unit: "WWI", num: 9, term: "Armenians in Turkey", def: "A Christian minority in the Ottoman Empire who suffered systematic deportations and mass killings between 1915 and 1923, resulting in roughly 1.5 million deaths. This is widely recognized as the first modern genocide of the 20th century." },
  { unit: "WWI", num: 10, term: "Zimmerman Telegram", def: "A 1917 secret message from Germany to Mexico proposing a military alliance against the United States, promising the return of Texas, New Mexico, and Arizona. Its interception by the British helped push the U.S. into WWI." },
  { unit: "WWI", num: 11, term: "Lenin and Bolsheviks", def: "Vladimir Lenin led the Bolshevik faction of Russian Marxists who seized power in the October Revolution of 1917. They withdrew Russia from WWI and established the world's first communist state." },
  { unit: "WWI", num: 12, term: "Bolshevik Communist State", def: "The government established in Russia after the 1917 revolution, based on Marxist-Leninist principles of state-controlled economy and one-party rule. It became the foundation for the Soviet Union in 1922." },
  { unit: "WWI", num: 13, term: "Global war", def: "A war that involves nations from multiple continents and affects much of the world's population and economies. WWI qualified as the first global war due to fighting in Europe, Africa, the Middle East, and the Pacific, and the involvement of colonial troops." },
  { unit: "WWI", num: 14, term: "Influenza epidemic", def: "The 1918–1919 flu pandemic, also called the Spanish Flu, that killed an estimated 50 million people worldwide. Spread by wartime troop movements, it killed more people than WWI itself." },
  { unit: "WWI", num: 15, term: "Treaty of Versailles", def: "The 1919 peace treaty ending WWI that imposed harsh terms on Germany, including massive reparations, territorial losses, and military restrictions. Its punitive nature is widely seen as contributing to the conditions that led to WWII." },
  { unit: "WWI", num: 16, term: "League of Nations", def: "An international organization founded in 1920 to maintain world peace and prevent future wars. It was weakened by the absence of the U.S. and ultimately failed to stop aggression by Japan, Italy, and Germany in the 1930s." },
  { unit: "WWI", num: 17, term: "Fourteen Points", def: "President Woodrow Wilson's 1918 plan for post-WWI peace, emphasizing self-determination, free trade, open diplomacy, and a League of Nations. Most points were rejected at Versailles, but they shaped 20th-century internationalism." },

  { unit: "Inter-War", num: 18, term: "Mandate System", def: "A post-WWI arrangement under the League of Nations in which former Ottoman and German colonies were administered by Allied powers like Britain and France. It was essentially colonialism rebranded, supposedly preparing territories for eventual independence." },
  { unit: "Inter-War", num: 19, term: "Great Depression", def: "A severe worldwide economic downturn that began with the 1929 U.S. stock market crash and lasted through the 1930s. It caused mass unemployment, fueled political extremism, and contributed to the rise of fascism in Europe." },
  { unit: "Inter-War", num: 20, term: "Totalitarianism", def: "A political system in which the state seeks total control over public and private life, including economy, media, and ideology. Examples include Stalinist USSR, Nazi Germany, and Fascist Italy." },
  { unit: "Inter-War", num: 21, term: "Fascism", def: "A far-right authoritarian ideology emphasizing extreme nationalism, militarism, dictatorship, and suppression of opposition. It originated in Italy under Mussolini and spread through Europe in the 1920s and 1930s." },
  { unit: "Inter-War", num: 22, term: "Corporatism", def: "An economic system, central to fascism, in which the state organizes society into corporate groups (labor, business, agriculture) that negotiate under government control. It was meant to replace class conflict with state-directed cooperation." },
  { unit: "Inter-War", num: 23, term: "Benito Mussolini", def: "Founder of Italian Fascism and dictator of Italy from 1922 to 1943, known as 'Il Duce.' He allied with Nazi Germany in WWII and was overthrown and executed in 1945." },
  { unit: "Inter-War", num: 24, term: "Nazism", def: "The ideology of Germany's National Socialist party, combining fascism with extreme racial antisemitism and belief in Aryan supremacy. It led to WWII and the Holocaust under Adolf Hitler's leadership." },
  { unit: "Inter-War", num: 25, term: "Adolph Hitler", def: "Leader of the Nazi Party and dictator of Germany from 1933 to 1945, who started WWII and orchestrated the Holocaust. His aggressive expansionism and genocidal policies caused tens of millions of deaths." },
  { unit: "Inter-War", num: 26, term: "Scientific racism", def: "The pseudoscientific belief that human races are biologically distinct and ranked in a hierarchy of intelligence and worth. It was used to justify imperialism, segregation, eugenics, and the Holocaust." },
  { unit: "Inter-War", num: 27, term: "Nuremberg Laws", def: "Anti-Jewish laws passed in Nazi Germany in 1935 that stripped Jews of citizenship and banned marriages between Jews and non-Jews. They were a major step toward the systematic persecution that became the Holocaust." },
  { unit: "Inter-War", num: 28, term: "Kristallnacht", def: "The 'Night of Broken Glass' in November 1938, when Nazis attacked Jewish homes, businesses, and synagogues across Germany and Austria. It marked a violent escalation from legal persecution to physical violence against Jews." },
  { unit: "Inter-War", num: 29, term: "NEP (New Economic Plan)", def: "Lenin's 1921 policy that allowed limited private enterprise and market activity in the Soviet Union to recover from civil war devastation. It was reversed by Stalin in favor of full state control and collectivization." },
  { unit: "Inter-War", num: 30, term: "U.S.S.R.", def: "The Union of Soviet Socialist Republics, formed in 1922 from Russia and surrounding territories under communist rule. It became a global superpower after WWII and dissolved in 1991." },
  { unit: "Inter-War", num: 31, term: "Joseph Stalin", def: "Soviet dictator from the late 1920s until his death in 1953, who industrialized the USSR through brutal Five-Year Plans and purges. His regime killed millions through famine, executions, and labor camps." },
  { unit: "Inter-War", num: 32, term: "Five-Year Plans", def: "Stalin's centralized economic programs to rapidly industrialize the USSR and collectivize agriculture, beginning in 1928. They achieved massive industrial growth at the cost of millions of lives, especially in Ukraine." },
  { unit: "Inter-War", num: 33, term: "New Deal", def: "Franklin D. Roosevelt's series of programs and reforms from 1933 onward to combat the Great Depression in the U.S. It expanded the federal government's role in the economy through job programs, regulations, and Social Security." },
  { unit: "Inter-War", num: 34, term: "Mexican Revolution", def: "A long civil conflict from 1910 to 1920 that overthrew the dictator Porfirio Díaz and produced major land, labor, and constitutional reforms. It featured leaders like Pancho Villa and Emiliano Zapata fighting for peasant rights." },
  { unit: "Inter-War", num: 35, term: "Porfirio Diaz", def: "Mexican president and dictator from 1876 to 1911, whose long rule favored foreign investors and wealthy landowners. His ousting sparked the Mexican Revolution." },
  { unit: "Inter-War", num: 36, term: "Emiliano Zapata", def: "A leader of the Mexican Revolution who championed peasant land rights with the slogan 'Tierra y Libertad' (Land and Liberty). He led the Liberation Army of the South before being assassinated in 1919." },
  { unit: "Inter-War", num: 37, term: "Lazaro Cardenas", def: "President of Mexico from 1934 to 1940 who carried out major land redistribution and nationalized the oil industry. His reforms fulfilled many goals of the Mexican Revolution and shaped modern Mexico." },
  { unit: "Inter-War", num: 38, term: "Turkish Nationalist Movement", def: "The post-WWI movement led by Mustafa Kemal Atatürk that abolished the Ottoman sultanate and established the secular Republic of Turkey in 1923. It modernized Turkey through Westernizing reforms in law, language, and dress." },
  { unit: "Inter-War", num: 39, term: "Women's suffrage", def: "The movement to secure women's right to vote, which achieved major victories in many countries during and after WWI. The U.S. ratified the 19th Amendment in 1920, and the UK granted full suffrage in 1928." },

  { unit: "WWII", num: 40, term: "Appeasement", def: "The 1930s policy by Britain and France of conceding to Hitler's territorial demands to avoid war, exemplified by the 1938 Munich Agreement. It is widely viewed as a failure that emboldened Nazi aggression." },
  { unit: "WWII", num: 41, term: "Axis Powers", def: "The WWII alliance of Germany, Italy, and Japan, plus several smaller states. They were defeated by the Allied Powers in 1945." },
  { unit: "WWII", num: 42, term: "Nanjing Massacre", def: "The mass murder and rape of Chinese civilians by Japanese troops in Nanjing in 1937–1938. Estimates range from 200,000 to 300,000 deaths, and it remains a deeply contested historical issue between China and Japan." },
  { unit: "WWII", num: 43, term: "Holocaust", def: "The systematic Nazi genocide of approximately six million European Jews, along with millions of Roma, disabled people, Slavs, and others. It was carried out through ghettos, mass shootings, and industrial-scale extermination camps." },
  { unit: "WWII", num: 44, term: "Yalta Conference", def: "A February 1945 meeting of FDR, Churchill, and Stalin to plan post-WWII Europe. It set the stage for the division of Germany, Soviet influence in Eastern Europe, and the founding of the United Nations." },
  { unit: "WWII", num: 45, term: "Potsdam Conference", def: "The July–August 1945 meeting of Allied leaders (Truman, Churchill/Attlee, Stalin) to finalize post-WWII arrangements. It addressed Germany's occupation, reparations, and the demand for Japan's unconditional surrender." },

  { unit: "Early Cold War", num: 46, term: "Cold War", def: "The geopolitical and ideological rivalry between the U.S. and USSR from 1947 to 1991, characterized by proxy wars, arms races, and competing alliances. It avoided direct military conflict between the superpowers but shaped global politics for decades." },
  { unit: "Early Cold War", num: 47, term: "United Nations", def: "An international organization founded in 1945 to promote peace, security, and cooperation among nations. It replaced the failed League of Nations and includes nearly every country today." },
  { unit: "Early Cold War", num: 48, term: "Iron Curtain", def: "Winston Churchill's 1946 metaphor for the political and ideological boundary dividing communist Eastern Europe from the democratic West. It symbolized the Cold War division of Europe until the fall of the Berlin Wall in 1989." },
  { unit: "Early Cold War", num: 49, term: "Containment", def: "The U.S. Cold War strategy of preventing the spread of communism beyond its existing borders. Articulated by diplomat George Kennan, it guided American foreign policy from the late 1940s through the 1980s." },
  { unit: "Early Cold War", num: 50, term: "Truman Doctrine", def: "President Truman's 1947 policy pledging U.S. support to nations resisting communism, beginning with aid to Greece and Turkey. It marked the formal beginning of containment and Cold War interventionism." },
  { unit: "Early Cold War", num: 51, term: "Marshall Plan", def: "A massive U.S. aid program providing over $13 billion to rebuild Western European economies after WWII. It strengthened those countries against communist influence and tied them economically to the U.S." },
  { unit: "Early Cold War", num: 52, term: "Berlin Airlift", def: "The 1948–1949 Allied operation to fly food and supplies into West Berlin after the Soviets blockaded all land routes. It successfully countered Soviet pressure without sparking war and lasted nearly a year." },
  { unit: "Early Cold War", num: 53, term: "NATO", def: "The North Atlantic Treaty Organization, a military alliance formed in 1949 by the U.S., Canada, and Western European nations. It was created to counter Soviet expansion through mutual defense commitments." },
  { unit: "Early Cold War", num: 54, term: "Warsaw Pact", def: "The 1955 military alliance of the Soviet Union and its Eastern European satellite states, formed in response to NATO. It dissolved in 1991 with the collapse of communism in Eastern Europe." },
  { unit: "Early Cold War", num: 55, term: "Proxy Wars", def: "Conflicts in which the U.S. and USSR supported opposing sides without directly fighting each other. Examples include Korea, Vietnam, Angola, and Afghanistan, where Cold War rivalries played out through local actors." },
  { unit: "Early Cold War", num: 56, term: "Korean War", def: "A 1950–1953 conflict in which UN forces (mostly American) defended South Korea against communist North Korea and China. It ended in stalemate at the 38th parallel, where the peninsula remains divided today." },
  { unit: "Early Cold War", num: 57, term: "Domino Theory", def: "The Cold War idea that if one country fell to communism, neighboring countries would follow like falling dominoes. It justified U.S. intervention in Vietnam and other Southeast Asian conflicts." },
  { unit: "Early Cold War", num: 58, term: "Ho Chi Minh", def: "Vietnamese communist revolutionary who led independence movements against French colonial rule and later U.S. forces. He became the first president of North Vietnam and is the namesake of Ho Chi Minh City." },
  { unit: "Early Cold War", num: 59, term: "Non-Aligned Movement", def: "A Cold War coalition of countries — including India, Egypt, Yugoslavia, and Indonesia — that refused to side with either the U.S. or USSR. Founded in 1961, it sought an independent path for newly decolonized nations." },

  { unit: "Chinese Revolution", num: 60, term: "May Fourth Movement", def: "A 1919 Chinese protest movement against the Treaty of Versailles giving German concessions in China to Japan. It sparked broader cultural and political changes, including increased interest in Marxism and modernization." },
  { unit: "Chinese Revolution", num: 61, term: "Dr. Sun Yat-Sen", def: "The founder of the Republic of China and leader of the Nationalist Party (Kuomintang) after the 1911 fall of the Qing dynasty. His 'Three Principles of the People' shaped both nationalist and communist movements in China." },
  { unit: "Chinese Revolution", num: 62, term: "CCP", def: "The Chinese Communist Party, founded in 1921, which won the Chinese Civil War in 1949 and has ruled mainland China ever since. It remains one of the largest political parties in the world." },
  { unit: "Chinese Revolution", num: 63, term: "Mao Zedong", def: "Founder of the People's Republic of China and leader of the CCP from 1949 until his death in 1976. His policies, including the Great Leap Forward and Cultural Revolution, caused tens of millions of deaths but cemented Communist rule." },
  { unit: "Chinese Revolution", num: 64, term: "Kuomintang", def: "The Chinese Nationalist Party led by Chiang Kai-shek, which fought the Japanese in WWII and the Communists in the Chinese Civil War. After losing in 1949, it retreated to Taiwan, where it ruled for decades." },
  { unit: "Chinese Revolution", num: 65, term: "Long March", def: "The 1934–1935 retreat of about 6,000 miles by Mao's communist forces to escape Nationalist encirclement in southern China. It established Mao's leadership of the CCP and became a foundational myth of Chinese communism." },
  { unit: "Chinese Revolution", num: 66, term: "Great Leap Forward", def: "Mao's 1958–1962 campaign to rapidly industrialize China and collectivize agriculture into communes. It caused a catastrophic famine that killed tens of millions of people and is considered one of history's worst man-made disasters." },
  { unit: "Chinese Revolution", num: 67, term: "Cultural Revolution", def: "Mao's 1966–1976 mass political movement to purge 'bourgeois' and traditional elements from Chinese society. Carried out by youthful Red Guards, it caused massive cultural destruction, persecution, and over a million deaths." },
  { unit: "Chinese Revolution", num: 68, term: "Deng Xiaoping", def: "Chinese leader from the late 1970s through the early 1990s who reversed Mao's policies and opened China to market reforms and foreign investment. He also ordered the suppression of the 1989 Tiananmen Square protests." },

  { unit: "Decolonization", num: 69, term: "Decolonization", def: "The process by which colonies in Asia, Africa, and elsewhere gained independence from European powers, mostly between 1945 and 1975. It dramatically expanded the number of sovereign nations and reshaped the global order." },
  { unit: "Decolonization", num: 70, term: "Amritsar", def: "The site of the 1919 massacre in India where British troops killed hundreds of unarmed Indian protesters. It galvanized the Indian independence movement and turned many moderates against British rule." },
  { unit: "Decolonization", num: 71, term: "Indian National Congress", def: "The major political party founded in 1885 that led India's independence movement under leaders like Gandhi and Nehru. It dominated Indian politics for decades after independence in 1947." },
  { unit: "Decolonization", num: 72, term: "Muslim League", def: "A political organization founded in 1906 to represent Indian Muslims, which under Jinnah pushed for a separate Muslim nation. Its efforts led to the creation of Pakistan in 1947." },
  { unit: "Decolonization", num: 73, term: "Pakistan", def: "A predominantly Muslim nation created in 1947 from the partition of British India. The partition caused massive violence and displaced over 10 million people along Hindu-Muslim lines." },
  { unit: "Decolonization", num: 74, term: "Mohandas Gandhi", def: "Indian independence leader who pioneered nonviolent resistance (satyagraha) against British rule. His tactics inspired civil rights movements worldwide before his assassination in 1948." },
  { unit: "Decolonization", num: 75, term: "Civil disobedience", def: "The nonviolent refusal to obey unjust laws as a form of political protest. Popularized by Thoreau and Gandhi, it became a key tactic in independence and civil rights movements globally." },
  { unit: "Decolonization", num: 76, term: "Salt March", def: "Gandhi's 240-mile march to the sea in 1930 to protest the British salt monopoly by making salt from seawater. It became a defining act of nonviolent resistance and gained worldwide attention." },
  { unit: "Decolonization", num: 77, term: "Muhammad Ali Jinnah", def: "Leader of the Muslim League and founder of Pakistan, where he served as the first Governor-General. He advocated the 'two-nation theory' arguing Hindus and Muslims needed separate states." },
  { unit: "Decolonization", num: 78, term: "Jawaharlal Nehru", def: "First Prime Minister of independent India, serving from 1947 to 1964. He pursued democratic socialism, secular government, and non-alignment in the Cold War." },
  { unit: "Decolonization", num: 79, term: "Gamal Abdel Nasser", def: "Egyptian president from 1956 to 1970 who promoted Pan-Arab nationalism and nationalized the Suez Canal. He became a leading voice of the Non-Aligned Movement and post-colonial Arab politics." },
  { unit: "Decolonization", num: 80, term: "Suez Crisis", def: "The 1956 conflict in which Britain, France, and Israel invaded Egypt after Nasser nationalized the Suez Canal. U.S. and Soviet pressure forced their withdrawal, marking the end of British and French dominance in the Middle East." },
  { unit: "Decolonization", num: 81, term: "Iranian Revolution", def: "The 1979 overthrow of the U.S.-backed Shah and establishment of an Islamic Republic under Ayatollah Khomeini. It transformed Iran into a theocracy and reshaped Middle Eastern politics for decades." },
  { unit: "Decolonization", num: 82, term: "Kwame Nkrumah", def: "First Prime Minister and President of Ghana, which gained independence from Britain in 1957 as the first sub-Saharan African colony to do so. He was a leading voice of Pan-Africanism before being overthrown in 1966." },
  { unit: "Decolonization", num: 83, term: "FLN (National Liberation Front)", def: "The Algerian movement that fought a brutal war from 1954 to 1962 to achieve independence from France. It became the dominant political party of post-independence Algeria." },
  { unit: "Decolonization", num: 84, term: "Biafran Civil War", def: "A 1967–1970 conflict in which the Igbo-majority region of southeastern Nigeria attempted to secede as the Republic of Biafra. It caused widespread famine and an estimated one to three million deaths before Biafra surrendered." },
  { unit: "Decolonization", num: 85, term: "Pan-Africanism", def: "A movement promoting unity, solidarity, and shared identity among African peoples and the African diaspora. It influenced independence movements and led to organizations like the Organization of African Unity (now the African Union)." },
  { unit: "Decolonization", num: 86, term: "Negritude", def: "A literary and cultural movement among French-speaking African and Caribbean writers in the 1930s that celebrated Black identity and African heritage. It rejected French colonial assimilation and influenced anti-colonial thought." },
  { unit: "Decolonization", num: 87, term: "Idi Amin of Uganda", def: "Brutal Ugandan dictator from 1971 to 1979 whose regime killed hundreds of thousands of people. He expelled Uganda's Asian population and was finally overthrown by a Tanzanian invasion." },
  { unit: "Decolonization", num: 88, term: "Balfour Declaration", def: "A 1917 British statement supporting the establishment of a Jewish homeland in Palestine, then under Ottoman rule. It laid the groundwork for the eventual creation of Israel and decades of Arab-Israeli conflict." },
  { unit: "Decolonization", num: 89, term: "Zionist Movement", def: "A Jewish nationalist movement, beginning in the late 1800s, advocating for a Jewish homeland in Palestine. It led to the founding of Israel in 1948 after the trauma of the Holocaust." },
  { unit: "Decolonization", num: 90, term: "PLO (Palestinian Liberation Organization)", def: "The political organization founded in 1964 to represent Palestinian Arabs and pursue Palestinian statehood. Long led by Yasser Arafat, it eventually recognized Israel in 1993 and helped form the Palestinian Authority." },
  { unit: "Decolonization", num: 91, term: "Pan-Arabism", def: "A movement promoting the political and cultural unification of Arab countries, especially popular in the 1950s and 1960s under Nasser. It declined after Arab defeats by Israel and the rise of Islamism." },
  { unit: "Decolonization", num: 92, term: "Augusto Pinochet", def: "Chilean military dictator from 1973 to 1990 who came to power in a U.S.-backed coup against the elected socialist Salvador Allende. His regime tortured and killed thousands while implementing free-market economic reforms." },
  { unit: "Decolonization", num: 93, term: "Neocolonialism", def: "The continued economic and political domination of former colonies by developed nations through trade, debt, and corporate influence rather than direct rule. The term was popularized by Kwame Nkrumah in the 1960s." },
  { unit: "Decolonization", num: 94, term: "Dollar Diplomacy", def: "Early 20th-century U.S. foreign policy of using economic investment and loans to expand influence in Latin America and East Asia. Associated with President Taft, it often backed up financial leverage with military intervention." },
  { unit: "Decolonization", num: 95, term: "Good Neighbor Policy", def: "FDR's 1930s shift in U.S. policy toward Latin America, renouncing direct military intervention in favor of cooperation. It marked a softening of decades of U.S. interventionism in the region." },
  { unit: "Decolonization", num: 96, term: "Sandinistas", def: "A leftist Nicaraguan revolutionary movement that overthrew the Somoza dictatorship in 1979 and ruled until 1990. They fought a long civil war against the U.S.-backed Contra rebels during the 1980s." },
  { unit: "Decolonization", num: 97, term: "PRI (Institutional Revolutionary Party)", def: "The dominant Mexican political party that held the presidency continuously from 1929 to 2000. It maintained one-party rule through patronage, election manipulation, and selective reform." },
  { unit: "Decolonization", num: 98, term: "Drug cartels", def: "Powerful criminal organizations that produce and traffic illegal drugs, especially in Latin America. Mexican and Colombian cartels have caused massive violence and political corruption since the 1980s." },
  { unit: "Decolonization", num: 99, term: "Liberation theology", def: "A Latin American Catholic movement, beginning in the 1960s, that interpreted Christianity as a call to fight poverty and oppression. It blended Catholic teaching with Marxist analysis and was opposed by the Vatican under Pope John Paul II." },

  { unit: "Late Cold War", num: 100, term: "Sputnik", def: "The first artificial satellite, launched by the Soviet Union in 1957, which began the space age. It shocked the U.S. and triggered the space race, leading to the creation of NASA." },
  { unit: "Late Cold War", num: 101, term: "Vietnam War", def: "A conflict from 1955 to 1975 in which communist North Vietnam fought against South Vietnam and its U.S. backers. It ended with North Vietnamese victory and unification, and remains a defining American military and political trauma." },
  { unit: "Late Cold War", num: 102, term: "Berlin Wall", def: "A barrier built by East Germany in 1961 to prevent its citizens from fleeing to West Berlin. Its fall in November 1989 became the defining symbol of the end of the Cold War." },
  { unit: "Late Cold War", num: 103, term: "Cuban Missile Crisis", def: "A 13-day standoff in October 1962 after the U.S. discovered Soviet nuclear missiles in Cuba. It is considered the closest the Cold War came to nuclear war and led to communication reforms like the Moscow-Washington hotline." },
  { unit: "Late Cold War", num: 104, term: "Nuclear weapons", def: "Weapons of mass destruction that derive their power from nuclear reactions, capable of destroying entire cities. Their existence shaped Cold War strategy through the doctrine of Mutually Assured Destruction (MAD)." },
  { unit: "Late Cold War", num: 105, term: "Arms Race", def: "The Cold War competition between the U.S. and USSR to build larger and more advanced nuclear arsenals. It produced tens of thousands of warheads and consumed massive resources on both sides." },
  { unit: "Late Cold War", num: 106, term: "Détente", def: "A 1970s easing of Cold War tensions between the U.S. and USSR, marked by arms control treaties like SALT and increased trade. It collapsed after the Soviet invasion of Afghanistan in 1979." },
  { unit: "Late Cold War", num: 107, term: "Richard Nixon", def: "U.S. President from 1969 to 1974 who pursued détente with the USSR and opened diplomatic relations with China. He resigned amid the Watergate scandal." },
  { unit: "Late Cold War", num: 108, term: "Leonid Brezhnev", def: "Soviet leader from 1964 to 1982 whose era was marked by détente, military buildup, and economic stagnation. The Brezhnev Doctrine asserted Soviet right to intervene in any communist country." },
  { unit: "Late Cold War", num: 109, term: "Economic liberalization", def: "The reduction of government regulation and control over markets in favor of free-market policies. It became a global trend in the 1980s under leaders like Thatcher, Reagan, and Deng Xiaoping." },
  { unit: "Late Cold War", num: 110, term: "Margaret Thatcher", def: "British Prime Minister from 1979 to 1990, known as the 'Iron Lady,' who privatized state industries and confronted labor unions. She allied closely with Reagan in opposing the Soviet Union." },
  { unit: "Late Cold War", num: 111, term: "Ronald Reagan", def: "U.S. President from 1981 to 1989 who took a hard line against the USSR while pursuing tax cuts and deregulation at home. His arms buildup and later negotiations with Gorbachev helped bring the Cold War to an end." },
  { unit: "Late Cold War", num: 112, term: "Afghanistan", def: "A country invaded by the Soviet Union in 1979 to prop up a communist government, leading to a decade-long war against U.S.-backed Mujahideen fighters. The Soviet defeat in 1989 contributed to the USSR's collapse." },
  { unit: "Late Cold War", num: 113, term: "Mikhail Gorbachev", def: "Last leader of the Soviet Union, who introduced reforms of glasnost (openness) and perestroika (restructuring) in the 1980s. His policies inadvertently led to the collapse of communism in Eastern Europe and the dissolution of the USSR in 1991." },

  { unit: "Post-Cold War", num: 114, term: "Asian Tigers", def: "The rapidly industrializing economies of Hong Kong, Singapore, South Korea, and Taiwan from the 1960s through 1990s. They became models of export-led growth and helped shift global economic power toward Asia." },
  { unit: "Post-Cold War", num: 115, term: "European Economic Community", def: "A regional organization founded in 1957 to promote economic integration among Western European nations. It evolved into the European Union in 1993." },
  { unit: "Post-Cold War", num: 116, term: "IRA (Irish Republican Army)", def: "A paramilitary group that fought to end British rule in Northern Ireland and unite it with the Republic of Ireland. Its long campaign of bombings and killings ended with the 1998 Good Friday Agreement." },
  { unit: "Post-Cold War", num: 117, term: "ETA", def: "A Basque separatist organization in Spain that used terrorism from 1959 to 2018 to seek independence for the Basque region. It killed over 800 people before officially disbanding." },
  { unit: "Post-Cold War", num: 118, term: "Martin Luther King, Jr.", def: "American civil rights leader who used nonviolent resistance, inspired by Gandhi, to fight racial segregation. His leadership helped achieve the 1964 Civil Rights Act before his assassination in 1968." },
